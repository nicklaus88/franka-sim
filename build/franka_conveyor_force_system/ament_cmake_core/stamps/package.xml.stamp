<?xml version="1.0"?>
<package format="3">
  <name>franka_conveyor_force_system</name><version>0.1.0</version>
  <description>Gazebo Harmonic force-driven conveyor approximation for free boxes</description>
  <maintainer email="maintainer@example.com">Franka conveyor contributors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gz_sim_vendor</depend><depend>gz_plugin_vendor</depend><depend>gz_transport_vendor</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
