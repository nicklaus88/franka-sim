<sdf version="1.9">
  <model name="d435">
    <static>true</static>
    <link name="camera_link">
      <visual name="housing">
        <pose>-0.0125 0 0 0 0 0</pose>
        <geometry><box><size>0.025 0.090 0.025</size></box></geometry>
        <material><ambient>0.65 0.65 0.67 1</ambient><diffuse>0.65 0.65 0.67 1</diffuse></material>
      </visual>
      <visual name="face">
        <pose>0.0005 0 0 0 0 0</pose>
        <geometry><box><size>0.001 0.085 0.021</size></box></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material>
      </visual>
      <visual name="left_lens">
        <pose>0.0015 0.025 0 0 1.5707963267948966 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.05 0.10 0.22 1</ambient><diffuse>0.05 0.10 0.22 1</diffuse></material>
      </visual>
      <visual name="right_lens">
        <pose>0.0015 -0.025 0 0 1.5707963267948966 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.05 0.10 0.22 1</ambient><diffuse>0.05 0.10 0.22 1</diffuse></material>
      </visual>
      <sensor name="rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/pickup_camera</topic>
        <camera>
          <optical_frame_id>camera_optical_frame</optical_frame_id>
          <horizontal_fov>1.5184364492350666</horizontal_fov>
          <image><width>848</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>5.0</far></clip>
          <depth_camera><clip><near>0.1</near><far>5.0</far></clip></depth_camera>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
